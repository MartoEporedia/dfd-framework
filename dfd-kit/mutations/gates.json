[
  {
    "id": "risk-medium-boundary",
    "file": "src/lib.rs",
    "before": "        >= 2",
    "after": "        >= 1",
    "tests": [
      "classification_is_proportional_and_new_service_uses_full"
    ],
    "purpose": "Una sola dimensione medium non deve diventare full."
  },
  {
    "id": "new-service-route",
    "file": "src/lib.rs",
    "before": "kind == Kind::NewService || level == Level::High",
    "after": "level == Level::High",
    "tests": [
      "classification_is_proportional_and_new_service_uses_full"
    ],
    "purpose": "Un nuovo servizio deve mantenere full completo anche con rischio low."
  },
  {
    "id": "unknown-risk-classification",
    "file": "src/lib.rs",
    "before": "    if !missing.is_empty() {",
    "after": "    if false {",
    "tests": [
      "unknown_risk_does_not_become_low_or_allow_specification"
    ],
    "purpose": "Dati di rischio ignoti non devono diventare low."
  },
  {
    "id": "design-review-freshness",
    "file": "src/lib.rs",
    "before": "latest.fingerprint != design_fingerprint(store, state)?",
    "after": "false",
    "tests": [
      "document_changes_require_review_reconfirmation_and_keep_history"
    ],
    "purpose": "La review di design non deve sopravvivere a modifiche della DoD o della specifica."
  },
  {
    "id": "development-human-gate",
    "file": "src/development.rs",
    "before": "if !matches!(gate, \"approved\" | \"approved-with-conditions\")",
    "after": "if false",
    "tests": [
      "development_requires_current_human_design_approval"
    ],
    "purpose": "Non iniziare lo sviluppo senza una decisione umana attuale."
  },
  {
    "id": "evidence-file-integrity",
    "file": "src/development.rs",
    "before": "if file.sha256 != store.hash(&file.path)?",
    "after": "if false",
    "tests": [
      "source_logs_and_plan_changes_invalidate_development"
    ],
    "purpose": "Codice e log modificati devono invalidare le evidenze."
  },
  {
    "id": "tdd-chronology",
    "file": "src/development.rs",
    "before": "red[task] > green[task] || ci.is_some_and(|date| date < green[task])",
    "after": "false",
    "tests": [
      "development_rejects_incomplete_unknown_failed_or_unordered_evidence"
    ],
    "purpose": "Evidenze fuori ordine red/green/CI non devono chiudere lo sviluppo."
  },
  {
    "id": "tdd-ci-required",
    "file": "src/development.rs",
    "before": "    if ci.is_none() {",
    "after": "    if false {",
    "tests": [
      "development_rejects_incomplete_unknown_failed_or_unordered_evidence"
    ],
    "purpose": "La suite CI verde è necessaria prima della pre-release."
  },
  {
    "id": "release-review-freshness",
    "file": "src/release.rs",
    "before": "decision.fingerprint != fingerprint(store, state)?",
    "after": "false",
    "tests": [
      "rollout_and_notes_changes_invalidate_release_review_without_losing_history"
    ],
    "purpose": "Modifiche a rollout e note devono rendere stale la review di release."
  },
  {
    "id": "release-development-freshness",
    "file": "src/release.rs",
    "before": "rollout.development_fingerprint != development_fingerprint(store, state)?",
    "after": "false",
    "tests": [
      "changed_source_blocks_release_and_updated_evidence_requires_rollout_refresh"
    ],
    "purpose": "Un rollout non deve restare valido dopo nuove evidenze di sviluppo."
  },
  {
    "id": "planned-resource-approval",
    "file": "src/release.rs",
    "before": "if !planned(&rollout).is_empty()",
    "after": "if false",
    "tests": [
      "planned_resources_need_conditional_decision_and_activation_evidence"
    ],
    "purpose": "Risorse pianificate non ammettono approvazione senza condizioni."
  },
  {
    "id": "rollout-complete-audience",
    "file": "src/release.rs",
    "before": "if previous != 100",
    "after": "if false",
    "tests": [
      "release_rejects_invalid_coverage_steps_tests_communications_and_questions"
    ],
    "purpose": "Il rollout deve raggiungere il 100% dell'audience prevista."
  },
  {
    "id": "rollout-monotonic-exposure",
    "file": "src/release.rs",
    "before": "|| step.percentage < previous",
    "after": "|| false",
    "tests": [
      "release_checks_rollout_progression_and_observation_duration_independently"
    ],
    "purpose": "Le percentuali di esposizione non devono diminuire nel piano."
  },
  {
    "id": "rollout-positive-duration",
    "file": "src/release.rs",
    "before": "|| step.duration_minutes == 0",
    "after": "|| false",
    "tests": [
      "release_checks_rollout_progression_and_observation_duration_independently"
    ],
    "purpose": "Ogni fase deve prevedere una durata di osservazione positiva."
  },
  {
    "id": "resource-ready-proof",
    "file": "src/release.rs",
    "before": "resource.status == Preparation::Ready && resource.evidence.is_empty()",
    "after": "false",
    "tests": [
      "ready_resource_requires_proof_even_with_complete_owner_and_reference"
    ],
    "purpose": "Una risorsa pronta richiede evidenze anche quando owner e riferimenti sono completi."
  },
  {
    "id": "stakeholder-communication-required",
    "file": "src/release.rs",
    "before": "if rollout.communications.is_empty()",
    "after": "if false",
    "tests": [
      "release_requires_a_real_communication_record"
    ],
    "purpose": "Comunicazioni assenti non devono superare il gate di release."
  },
  {
    "id": "nonfunctional-test-success",
    "file": "src/release.rs",
    "before": "|| execution.exit_code != 0",
    "after": "|| false",
    "tests": [
      "nonfunctional_execution_requires_success_and_unchanged_log"
    ],
    "purpose": "Test non funzionali falliti devono bloccare la release."
  },
  {
    "id": "schema-version-required",
    "file": "src/store.rs",
    "before": "if value[\"schema_version\"] != 1",
    "after": "if false",
    "tests": [
      "unsupported_json_schema_preserves_assessed_state"
    ],
    "purpose": "Rifiutare versioni JSON non supportate senza cambiare lo stato."
  }
]
